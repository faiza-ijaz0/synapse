# SYNAPSE environment template. Copy to `.env` and fill in values.
# `.env` is git-ignored. Never commit real secrets. See docs/07-environment-variables.md.

NODE_ENV=development
LOG_LEVEL=info

# --- API ---
SYNAPSE_API_HOST=127.0.0.1
SYNAPSE_API_PORT=4000
# Origin of the web UI; used for Origin/Host checks and CORS.
SYNAPSE_WEB_ORIGIN=http://localhost:5173

# --- Secrets (generate locally; see docs/09-local-development.md) ---
# 32+ random bytes, base64. Signs session cookies.
SYNAPSE_SESSION_SECRET=
# 32 random bytes, base64. AES-256-GCM key for stored API-test credentials.
SYNAPSE_ENCRYPTION_KEY=

# --- PostgreSQL (dedicated least-privilege role, not `postgres`) ---
DATABASE_URL=postgresql://synapse:CHANGE_ME@127.0.0.1:5432/synapse?schema=public
# Separate database for integration tests (truncated between runs).
DATABASE_URL_TEST=postgresql://synapse:CHANGE_ME@127.0.0.1:5432/synapse_test?schema=public

# --- Job queue (pg-boss, stored in PostgreSQL; no extra service) ---
# Schema pg-boss creates and manages inside the database above.
SYNAPSE_QUEUE_SCHEMA=pgboss

# --- Worker limits ---
SYNAPSE_WORKER_CONCURRENCY=2
SYNAPSE_JOB_TIMEOUT_MS=300000

# --- Outbound HTTP limits (API testing, site audits) ---
SYNAPSE_HTTP_TIMEOUT_MS=15000
SYNAPSE_HTTP_MAX_RESPONSE_BYTES=5242880
SYNAPSE_HTTP_MAX_REDIRECTS=5

# --- Local storage for artifacts (reports, uploaded test results) ---
SYNAPSE_DATA_DIR=./.synapse-data
SYNAPSE_MAX_UPLOAD_BYTES=20971520

# --- Optional AI (disabled by default) ---
# none | ollama
SYNAPSE_AI_PROVIDER=none
SYNAPSE_OLLAMA_URL=http://127.0.0.1:11434
SYNAPSE_OLLAMA_MODEL=
