# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo
coverage/

# Environment and secrets — never commit real values
.env
.env.*
!.env.example

# Keys, certificates, and database dumps (never `*.sql`: migrations are committed)
*.pem
*.key
*.p12
*.pfx
*.dump
*.backup
*.sql.gz

# Tool caches
.eslintcache
.prettiercache

# Runtime data (audit artifacts, uploads, logs)
.synapse-data/
*.log
logs/

# Test output
playwright-report/
test-results/
blob-report/

# Editors / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Prisma generated client (regenerated by `pnpm install` / `pnpm db:generate`)
packages/db/src/generated/
