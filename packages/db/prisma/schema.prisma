// SYNAPSE database schema. Prisma owns the `public` schema only; pg-boss owns
// `pgboss` (ADR-0012). Table and column names are snake_case in PostgreSQL.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// The single local user (ADR-0001, ADR-0009). `singleton` is unique and the
/// migration adds CHECK (singleton), so the table can hold at most one row.
model User {
  id           String        @id @default(uuid(7)) @db.Uuid
  singleton    Boolean       @unique @default(true)
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions     Session[]
  accessTokens AccessToken[]

  @@map("users")
}

/// Browser session. `id` is the SHA-256 hash of the cookie value; the raw
/// value is never stored.
model Session {
  id         String   @id @db.Char(64)
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("sessions")
}

/// CLI personal access token. Only the SHA-256 hash is stored.
model AccessToken {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String    @db.VarChar(100)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  scopes     String[]
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, name])
  @@map("access_tokens")
}

model Project {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(2000)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  runs        Run[]

  @@map("projects")
}

enum RunKind {
  CODE_ANALYSIS @map("code_analysis")
  API_TEST      @map("api_test")
  SITE_AUDIT    @map("site_audit")
  TEST_IMPORT   @map("test_import")

  @@map("run_kind")
}

enum RunStatus {
  QUEUED    @map("queued")
  RUNNING   @map("running")
  SUCCEEDED @map("succeeded")
  FAILED    @map("failed")
  CANCELLED @map("cancelled")

  @@map("run_status")
}

enum RunTrigger {
  UI       @map("ui")
  CLI      @map("cli")
  SCHEDULE @map("schedule")

  @@map("run_trigger")
}

/// One execution of an analysis, test, audit, or import.
model Run {
  id           String     @id @default(uuid(7)) @db.Uuid
  projectId    String     @map("project_id") @db.Uuid
  kind         RunKind
  status       RunStatus  @default(QUEUED)
  trigger      RunTrigger
  /// Versions of every tool that produced results, e.g. {"eslint":"10.13.0"}.
  toolVersions Json       @default("{}") @map("tool_versions")
  /// Non-sensitive failure summary; full details go to logs.
  error        String?    @db.VarChar(2000)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  startedAt    DateTime?  @map("started_at") @db.Timestamptz(3)
  finishedAt   DateTime?  @map("finished_at") @db.Timestamptz(3)
  project      Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, kind, createdAt(sort: Desc)])
  @@index([status])
  @@map("runs")
}
